# Copy to .env.local (git-ignored).

# Optional — enables the embedded wallet (Google / Apple login).
# Register the app at https://phantom.com/portal and whitelist the redirect
# URLs: http://localhost:5173/ and https://<you>.github.io/lamport-lens/
VITE_PHANTOM_APP_ID=

# Optional — defaults to the public devnet endpoint, which is rate-limited.
# A free Helius devnet key is more reliable for the WebSocket drill.
VITE_RPC_URL=
