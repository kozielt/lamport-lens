# Copy to .env.local (git-ignored).

# Optional — enables the embedded wallet (Google / Apple login). Leave empty
# to run extension-only; nothing else in the app needs it.
# App IDs come from https://phantom.com/portal (new sign-ups paused as of
# 2026-09). Redirect URLs to whitelist there: http://localhost:5173/ and
# https://<you>.github.io/lamport-lens/
VITE_PHANTOM_APP_ID=

# Optional — defaults to the public devnet endpoint, which is rate-limited.
# A free Helius devnet key is more reliable for the WebSocket drill.
VITE_RPC_URL=
